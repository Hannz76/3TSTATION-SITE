{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build --outDir dist",
    "lint": "tsc --noEmit && biome lint src",
    "format": "biome format --write src",
    "preview": "vite preview",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:migrate": "wrangler d1 migrations apply REVIEWS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply REVIEWS_DB --remote",
    "preview:full": "npm run build && npm run db:migrate && npm run dev:api",
    "test:reviews": "node tests/reviews.mjs",
    "test:smoke": "node smoke.mjs",
    "test:waves": "node tests/gradient-waves.mjs",
    "test:repair": "node tests/repair-selection.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy:ci": "npm run check:deploy && npm run db:migrate:remote && wrangler deploy",
    "deploy": "npm run check:deploy && npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grab": "latest",
    "same-runtime": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "wrangler": "^4.147.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
