{
  "name": "3tstation-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "REVIEWS_DB",
      "database_name": "3tstation-reviews",
      "database_id": "local-reviews-db",
      "migrations_dir": "migrations"
    }
  ]
}
